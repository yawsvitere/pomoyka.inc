# Для Linux-сервера используйте ./install.sh: он сам сгенерирует секреты.
# Этот файл оставлен для ручной настройки.

# PostgreSQL
POSTGRES_USER=replace_with_postgres_user
POSTGRES_PASSWORD=replace_with_long_random_password
POSTGRES_DB=feeddb

# MinIO 
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_long_random_password
MINIO_BUCKET=feed-files

# domain
MINIO_PUBLIC_ENDPOINT=localhost

# JWT
JWT_SECRET=replace_with_long_random_jwt_secret

ADMIN_EMAIL=admin@example.com

DATAPROTECTION_CERT_PASSWORD=replace_with_long_random_password